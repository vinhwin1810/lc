class Solution:
    def checkInclusion(self, s1: str, s2: str) -> bool:
        if len(s1) > len(s2):
            return False
        
        count1 = Counter(s1)
        count2 = Counter(s2[:len(s1)])

        if count1 == count2:
            return True

        l = 0
        for i in range(len(s1), len(s2)):
            
            count2[s2[i]] = count2.get(s2[i], 0) + 1
            count2[s2[l]] -= 1
            l += 1
            if count2[s2[l]] == 0:
                del count2[s2[l]]
            
            if count1 == count2:
                return True
        
        return False
